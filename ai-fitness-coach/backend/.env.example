# ===== FitVision AI · Backend Environment =====
# Copy this file to .env and fill in real values.

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (Mongo is optional — the API falls back to an
# in-memory store (seed demo accounts) when Mongo is unreachable).
MONGO_URI=mongodb://localhost:27017/ai-fitness-coach

# Gemini — used for AI plan generation & RAG coaching chat. The model id is
# configured centrally in src/config/gemini.js (default: gemini-2.5-flash).
# Leave blank to use the built-in rule-based plan/chat fallbacks.
GEMINI_API_KEY=

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated allow-list of frontend origins for CORS.
# ALLOWED_ORIGINS is canonical; CORS_ORIGINS is still accepted as a fallback.
# Defaults to the Vite dev server (http://localhost:3000).
ALLOWED_ORIGINS=http://localhost:3000

# Optional per-endpoint rate-limit overrides (requests per window).
# AUTH_RATE_MAX=500   # register/login/forgot/reset (15 min)
# API_RATE_MAX=1000   # general API (15 min)
# PLAN_RATE_MAX=100   # plan regeneration (24 h)
# CHAT_RATE_MAX=500   # chat (1 h)

# ── Admin bootstrap (dev / first deploy only) ─────────────────────────────────
# Set to true ONCE to auto-create admin@fitvision.ai at boot when it does not
# exist. The password is randomly generated and printed to the console (or set
# ADMIN_PASSWORD). Existing admin accounts are NEVER modified on boot.
ADMIN_BOOTSTRAP=false
ADMIN_PASSWORD=

# Optional fixed password for the demo user in the in-memory fallback store
# (development only). When blank, a random password is printed at startup.
DEMO_USER_PASSWORD=

# Password reset (dev only): when true, the reset token is also returned in the
# API response body. Production resets require an email transport, which is not
# in the stack yet — see SECURITY.md.
RESET_TOKEN_DEBUG=false